{
  "name": "parallax",
  "version": "2.0.0",
  "description": "A perspective aware news reader with live feeds, sentiment and bias analysis, for the web and desktop",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "Ishaan Manoor",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "web": "node scripts/serve.js",
    "web:offline": "node scripts/serve.js --offline",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.parallax.news",
    "productName": "Parallax",
    "files": [
      "electron/**",
      "server/**",
      "src/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.news"
    },
    "linux": {
      "target": "AppImage",
      "category": "News"
    }
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.7",
    "vader-sentiment": "^1.1.3"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
