{
  "name": "parallax",
  "version": "1.0.0",
  "description": "A perspective aware news reader for the web and desktop",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "Ishaan Manoor",
  "scripts": {
    "web": "node scripts/serve.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.parallax.news",
    "productName": "Parallax",
    "files": ["electron/**", "src/**", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.news" },
    "linux": { "target": "AppImage", "category": "News" }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
